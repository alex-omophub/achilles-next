!NAMESPACE
!LICENSE
!LICENSE.md
!README.md
!.Rbuildignore
!.github/
!.github/workflows/
!.github/workflows/count-tracer.yml
!R/
!R/**
!man/
!man/**
!inst/
!inst/**
!tests/
!tests/**
!tools/
!tools/**
!packages/
!packages/**
**/node_modules
**/__pycache__
**/*.pyc
**/.local
**/.env*
**/.Renviron*
**/.Rhistory
**/.RData
**/.pgpass
**/.pg_service.conf
**/dist
**/build
**/coverage
**/*.pem
**/*.key
**/pgpass
**/pg_service.conf
