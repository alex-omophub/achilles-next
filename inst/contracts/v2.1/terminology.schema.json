{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:achilles-next:saved-terminology:1.0.0",
  "$comment": "Structural independent oracle. Native R additionally enforces UTF-8 byte limits, control rejection, matching/order, scope membership and complete ID/name equivalence.",
  "$defs": {
    "concept_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept_tag",
            "label",
            "label_state",
            "label_reason_code",
            "domain_id",
            "vocabulary_id"
          ],
          "properties": {
            "concept_tag": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "id"
                },
                "value": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,511}|-[1-9][0-9]{0,511})$"
                }
              }
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "label_state": {
              "const": "available"
            },
            "label_reason_code": {
              "type": "null"
            },
            "domain_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "vocabulary_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
