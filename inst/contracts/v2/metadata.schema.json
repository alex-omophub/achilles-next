{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:achilles-next:metadata-values:2.0.0",
  "$defs": {
    "count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_.:-]{1,96}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "basis",
        "assertion_id",
        "reason_code"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "assertion_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "complete",
        "excluded_record_count",
        "reason_code"
      ],
      "properties": {
        "scope_kind": {
          "enum": [
            "standard_full",
            "declared_reduced",
            "schema_conditional"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "excluded_record_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/count"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "within_run",
        "reusable",
        "reason_code"
      ],
      "properties": {
        "within_run": {
          "enum": [
            "unknown",
            "single_repeatable_read",
            "verified_immutable_source"
          ]
        },
        "reusable": {
          "type": "boolean"
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "core.source.passport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_release",
        "declared_cdm_version",
        "observed_schema",
        "vocabulary_release",
        "profile",
        "coverage",
        "generation",
        "consistency"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_release": {
          "$ref": "#/$defs/identity"
        },
        "declared_cdm_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observed_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "reason_code"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "reason_code": {
              "$ref": "#/$defs/reason"
            }
          }
        },
        "vocabulary_release": {
          "$ref": "#/$defs/identity"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "ended_at"
          ],
          "properties": {
            "started_at": {
              "$ref": "#/$defs/time"
            },
            "ended_at": {
              "$ref": "#/$defs/time"
            }
          }
        },
        "consistency": {
          "$ref": "#/$defs/consistency"
        }
      }
    },
    "core.source.capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "observed_type"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "available_empty",
            "absent",
            "inaccessible"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        },
        "observed_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "core.execution.output_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "required",
        "coverage",
        "integrity"
      ],
      "properties": {
        "state": {
          "enum": [
            "computed",
            "empty_source",
            "empty_population",
            "suppressed",
            "unsupported",
            "unavailable",
            "inaccessible",
            "failed",
            "not_requested"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        },
        "required": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "sha256",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "validated",
                "not_validated"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason_code": {
              "$ref": "#/$defs/reason"
            }
          }
        }
      }
    },
    "core.execution.timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "telemetry",
        "availability",
        "reason_code"
      ],
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/count"
            },
            {
              "type": "null"
            }
          ]
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_ms",
            "peak_memory_bytes",
            "source_rows",
            "temp_bytes"
          ],
          "properties": {
            "cpu_ms": {
              "anyOf": [
                {
                  "$ref": "#/$defs/count"
                },
                {
                  "type": "null"
                }
              ]
            },
            "peak_memory_bytes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/count"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_rows": {
              "anyOf": [
                {
                  "$ref": "#/$defs/count"
                },
                {
                  "type": "null"
                }
              ]
            },
            "temp_bytes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/count"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "availability": {
          "enum": [
            "measured",
            "unavailable"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/core.source.passport"
    },
    {
      "$ref": "#/$defs/core.source.capabilities"
    },
    {
      "$ref": "#/$defs/core.execution.output_status"
    },
    {
      "$ref": "#/$defs/core.execution.timing"
    }
  ]
}
